# Copy to ".env" and fill in. The sweep auto-loads this file.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults shown):
# SWEEP_EXTRACT_MODEL=claude-sonnet-4-6
# SWEEP_VERIFY_MODEL=claude-sonnet-4-6
# SWEEP_LOOKBACK_DAYS=7      # the brief: STRICT announcement window (don't change for a weekly)
# SWEEP_SEARCH_DAYS=14       # wider candidate-search net (recall only; never relaxes the 7-day gate)
# SWEEP_RAISE_MIN_USD=25000000
# SWEEP_GAPFILL_ROUNDS=4
